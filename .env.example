# Database. Local development uses SQLite. Warehouse PC SQL Server example
# (the \ in the instance name is written as %5C; this PC has ODBC Driver 17):
# DATABASE_URL=mssql+pyodbc://@localhost%5CSQLEXPRESS/BritechJobEntry?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes
DATABASE_URL=sqlite:///./dev.db

# PDF files. Leave blank locally (files go to backend/storage/pdfs, no backup copy).
# On the warehouse PC set PDF_STORAGE_DIR to the folder on that PC and
# PDF_BACKUP_DIR to the DiskStation share that should get a copy of each PDF.
PDF_STORAGE_DIR=
PDF_BACKUP_DIR=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_INPUT_COST_PER_MILLION=1.00
ANTHROPIC_OUTPUT_COST_PER_MILLION=5.00

# Extraction provider: claude | fake
EXTRACTION_PROVIDER=claude

# Upload limits
MAX_UPLOAD_SIZE_MB=15
MAX_PDF_PAGES=10

# Stale extraction recovery. Jobs whose heartbeat is older than this
# are treated as crashed and become eligible for recovery.
HEARTBEAT_STALE_SECONDS=120

# Worker
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
HEARTBEAT_INTERVAL_SECONDS=15

# PDF rendering for Claude vision
PDF_RENDER_DPI=150

# CORS (comma-separated). Leave empty to allow all local Vite origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (used at Vite build time)
VITE_API_BASE_URL=

# ShopKeeper (Phase 2). Keep credentials out of git.
# shopkeeper = live SQL Server; fake = in-memory ERP for tests/UI without SQL.
SHOPKEEPER_PROVIDER=shopkeeper
SHOPKEEPER_CONNECTION_STRING=DRIVER=
SHOPKEEPER_EXPECTED_DATABASE=
SHOPKEEPER_NON_TAX_CODE=NT
SHOPKEEPER_NEW_JOB_STATUS=NA
SHOPKEEPER_JOB_RESERVE_RETRIES=5
WAREHOUSE_PRINTER_NAME=
PART_PHOTOS_DIR=\\DISKSTATION\PartPhotos
APP_VERSION=0.2.0
